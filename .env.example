# Vercel + local. NEVER put Admin API credentials here (see .env.seed.example).
SHOPWARE_STORE_API_URL=https://shopware.example.invalid
SHOPWARE_SW_ACCESS_KEY=SWSCPLACEHOLDERACCESSKEY

# Seeded persona logins (server-only; never NEXT_PUBLIC_)
PERSONA_RETAIL_EMAIL=retail.rider@example.com
PERSONA_RETAIL_PASSWORD=change-me
PERSONA_DEALER_ADMIN_EMAIL=dealer.admin@example.com
PERSONA_DEALER_ADMIN_PASSWORD=change-me
PERSONA_DEALER_JUNIOR_EMAIL=junior.buyer@example.com
PERSONA_DEALER_JUNIOR_PASSWORD=change-me

# Demo gate
DEMO_PASSWORD=change-me
# 32+ random bytes, e.g. `openssl rand -base64 48`
DEMO_COOKIE_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Per-prospect brand override (public, not a secret)
NEXT_PUBLIC_BRAND_NAME=Trailhead Parts Supply (Demo)
