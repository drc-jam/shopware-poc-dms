{
  "name": "powersports-b2b-shopware-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "tour:generate": "node tools/tour-generate.mjs",
    "tour:screenshots": "TOUR_SCREENSHOTS=docs/tour playwright test e2e/phase7-tour.spec.ts --trace off",
    "mock:store-api": "node e2e/mock-store-api.mjs",
    "fixture:validate": "node seed/validate-fixture.mjs",
    "fixture:review": "node tools/fixture-review.mjs",
    "check:bundle-secrets": "node tools/check-bundle-secrets.mjs",
    "seed:discover": "node seed/discover.mjs",
    "seed:init-env": "node tools/init-seed-env.mjs",
    "spike:phase0": "node seed/spikes/phase0.mjs",
    "seed:plan": "node seed/plan.mjs",
    "seed:apply": "node seed/apply.mjs",
    "seed:verify": "node seed/verify.mjs",
    "fitment:build": "node seed/build-fitment.mjs",
    "types:generate": "node tools/generate-store-types.mjs",
    "fixture:approve": "node tools/fixture-approve.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
