{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.invalid/schemas/site-project.demo.schema.json",
  "title": "Powersports B2B demo site project (composed: site-project.json + vehicles.json)",
  "$comment": "PENDING FACTORY RECONCILIATION: DEV_GUIDE §7.2 says to extend the factory site-project.schema.json (vryan-shopware/shopware-demo-creator @ c809638). That repo was not readable when this was written, so the shapes of the factory roots (source, currency, categories, products, customers) are defined here from the guide's example and must be reconciled with the factory schema before Phase 2. The demo extensions (vehicles, series, personas, brands, b2b, products[].demo) are authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "currency", "categories", "products", "customers", "vehicles", "series", "personas", "brands", "b2b"],
  "properties": {
    "$schema": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "extractionSource", "priceConfidence"],
      "properties": {
        "type": { "const": "synthetic-fixture" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "extractionSource": { "$ref": "#/$defs/extractionSource" },
        "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
      }
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "fictional", "extractionSource", "priceConfidence"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "name": { "type": "string", "minLength": 1 },
          "fictional": { "const": true },
          "extractionSource": { "$ref": "#/$defs/extractionSource" },
          "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "extractionSource", "priceConfidence"],
        "properties": {
          "path": { "$ref": "#/$defs/categoryPath" },
          "description": { "type": "string" },
          "extractionSource": { "$ref": "#/$defs/extractionSource" },
          "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
        }
      }
    },
    "vehicles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vehicle" } },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label", "tiers", "extractionSource", "priceConfidence"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minQty", "discountPct"],
              "properties": {
                "minQty": { "type": "integer", "minimum": 2 },
                "discountPct": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 50 }
              }
            }
          },
          "extractionSource": { "$ref": "#/$defs/extractionSource" },
          "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
        }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "enum": ["retail", "dealer-admin", "dealer-junior"] },
          "label": { "type": "string", "minLength": 1 },
          "customer": { "$ref": "#/$defs/key" },
          "employee": { "$ref": "#/$defs/key" }
        },
        "oneOf": [{ "required": ["customer"] }, { "required": ["employee"] }]
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productNumber", "name", "brand", "categoryPath", "price", "stock", "media", "demo", "extractionSource", "priceConfidence"],
        "properties": {
          "productNumber": { "type": "string", "pattern": "^[A-Z]{3}-[A-Z]{2}-[A-Z]-[0-9]{4}$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 120 },
          "brand": { "type": "string", "minLength": 1 },
          "categoryPath": { "$ref": "#/$defs/categoryPath" },
          "description": { "type": "string" },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gross"],
            "properties": { "gross": { "$ref": "#/$defs/money" } }
          },
          "stock": { "type": "integer", "minimum": 0 },
          "media": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^media/[a-z0-9-]+\\.(png|jpg|jpeg|webp)$" }
          },
          "demo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mapPolicy", "dealerTiers", "fitment"],
            "properties": {
              "series": { "type": "string", "pattern": "^[A-Z]$" },
              "mapPolicy": { "enum": ["none", "hide_until_cart"] },
              "dealerTiers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["minQty", "gross"],
                  "properties": {
                    "minQty": { "type": "integer", "minimum": 1 },
                    "gross": { "$ref": "#/$defs/money" }
                  }
                }
              },
              "fitment": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/vehicleKey" } }
            }
          },
          "extractionSource": { "$ref": "#/$defs/extractionSource" },
          "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
        }
      }
    },
    "customers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "salutation", "firstName", "lastName", "email", "customerGroup", "passwordEnv", "address", "extractionSource", "priceConfidence"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "salutation": { "type": "string" },
          "firstName": { "type": "string", "minLength": 1 },
          "lastName": { "type": "string", "minLength": 1 },
          "email": { "$ref": "#/$defs/demoEmail" },
          "customerGroup": { "enum": ["Retail", "Dealer"] },
          "company": { "type": "string" },
          "passwordEnv": { "$ref": "#/$defs/envName" },
          "address": { "$ref": "#/$defs/address" },
          "extractionSource": { "$ref": "#/$defs/extractionSource" },
          "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
        }
      }
    },
    "b2b": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "roles", "employees", "approvalRules", "shoppingLists"],
      "properties": {
        "company": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownerCustomer", "features"],
          "properties": {
            "ownerCustomer": { "$ref": "#/$defs/key" },
            "features": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["employee_management", "order_approval", "quick_order", "shopping_list"] }
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "name"],
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "name": { "type": "string", "minLength": 1 },
              "permissions": { "type": "array", "items": { "type": "string" } },
              "permissionIntents": { "type": "array", "items": { "type": "string" } }
            },
            "oneOf": [{ "required": ["permissions"] }, { "required": ["permissionIntents"] }]
          }
        },
        "employees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "firstName", "lastName", "email", "role", "active", "passwordEnv", "extractionSource", "priceConfidence"],
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "firstName": { "type": "string", "minLength": 1 },
              "lastName": { "type": "string", "minLength": 1 },
              "email": { "$ref": "#/$defs/demoEmail" },
              "role": { "$ref": "#/$defs/key" },
              "active": { "type": "boolean" },
              "passwordEnv": { "$ref": "#/$defs/envName" },
              "extractionSource": { "$ref": "#/$defs/extractionSource" },
              "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
            }
          }
        },
        "approvalRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "name", "affectedRole", "reviewerRole", "condition"],
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "name": { "type": "string", "pattern": "^DEMO · " },
              "affectedRole": { "$ref": "#/$defs/key" },
              "reviewerRole": { "$ref": "#/$defs/key" },
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": { "type": { "const": "cartAmountGte" }, "value": { "type": "number", "exclusiveMinimum": 0 } }
              }
            }
          }
        },
        "shoppingLists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "name", "owner", "items"],
            "properties": {
              "key": { "$ref": "#/$defs/key" },
              "name": { "type": "string", "minLength": 1 },
              "owner": { "$ref": "#/$defs/key" },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["productNumber", "quantity"],
                  "properties": {
                    "productNumber": { "type": "string" },
                    "quantity": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "extractionSource": { "const": "synthetic-fixture" },
    "priceConfidence": { "const": "generated" },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "envName": { "type": "string", "pattern": "^PERSONA_[A-Z_]+_PASSWORD$" },
    "money": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
    "demoEmail": { "type": "string", "format": "email", "pattern": "@example\\.com$" },
    "categoryPath": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "vehicleKey": { "type": "string", "pattern": "^[A-Z]{3}-[A-Z0-9]+-[0-9]{4}-[0-9]{4}$" },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "make", "model", "yearFrom", "yearTo", "type", "extractionSource", "priceConfidence"],
      "properties": {
        "key": { "$ref": "#/$defs/vehicleKey" },
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "yearFrom": { "type": "integer", "minimum": 1980, "maximum": 2100 },
        "yearTo": { "type": "integer", "minimum": 1980, "maximum": 2100 },
        "type": { "enum": ["ATV", "UTV", "Motorcycle", "Snowmobile", "PWC"] },
        "extractionSource": { "$ref": "#/$defs/extractionSource" },
        "priceConfidence": { "$ref": "#/$defs/priceConfidence" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street", "zipcode", "city", "countryIso"],
      "properties": {
        "street": { "type": "string", "minLength": 1 },
        "zipcode": { "type": "string" },
        "city": { "type": "string", "minLength": 1 },
        "countryIso": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}
